{
  "name": "view-shadcn-ui",
  "description": "View Shadcn UI is a Vue3 component library built on Tailwind CSS.",
  "keywords": [
    "vue",
    "vue3",
    "component",
    "library",
    "shadcn",
    "tailwind css"
  ],
  "author": "devlive-community",
  "homepage": "https://view-shadcn-ui.devlive.org",
  "private": false,
  "version": "2024.5.3",
  "license": "MIT",
  "main": "./dist/view-shadcn.umd.ts",
  "module": "./dist/view-shadcn.es.ts",
  "types": "types/view-shadcn.d.ts",
  "exports": {
    ".": {
      "import": "./dist/view-shadcn-ui.es.ts",
      "require": "./dist/view-shadcn-ui.umd.ts",
      "style": "./dist/view-shadcn-ui.css"
    }
  },
  "files": [
    "dist/*"
  ],
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "standard-version": {
    "scripts": {
      "postchangelog": "npx prettier --write CHANGELOG.md"
    },
    "types": [
      {
        "type": "feat",
        "section": "✨ Features",
        "hidden": false
      },
      {
        "type": "fix",
        "section": "🐛 Bug Fixes",
        "hidden": false
      },
      {
        "type": "docs",
        "section": "📚 Documentation",
        "hidden": false
      },
      {
        "type": "style",
        "section": "🎨 Style",
        "hidden": false
      },
      {
        "type": "refactor",
        "section": "⚡️ Refactor",
        "hidden": false
      },
      {
        "type": "improvement",
        "section": "⚡️ Improvements",
        "hidden": false
      },
      {
        "type": "test",
        "section": "✅ Tests",
        "hidden": false
      },
      {
        "type": "build",
        "section": "🚀 Build",
        "hidden": false
      },
      {
        "type": "revert",
        "section": "⏪ Revert",
        "hidden": false
      }
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && tailwindcss build src/assets/index.css -o dist/view-shadcn-ui.min.css --minify",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "release": "standard-version --skip.bump=true --skip.tag=true --skip.commit=true && sh configure/publish/publish-deploy-page.sh && yes '3' | sh configure/publish/publish-deploy-npm.sh",
    "release:patch": "standard-version --release-as patch --skip.bump=true --skip.tag=true --skip.commit=true"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "highlight.js": "^11.10.0",
    "lodash": "^4.17.21",
    "lucide-vue-next": "^0.360.0",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^2.2.2",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "axios": "^1.7.8",
    "postcss": "^8.4.47",
    "standard-version": "^9.5.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vitepress": "^1.4.1",
    "vue-tsc": "^2.0.6"
  }
}
