{
  "name": "view-shadcn-ui",
  "description": "View Shadcn UI is a Vue3 component library built on Tailwind CSS.",
  "keywords": [
    "vue",
    "vue3",
    "component",
    "library",
    "shadcn",
    "tailwind css"
  ],
  "author": "devlive-community",
  "homepage": "https://view-shadcn-ui.devlive.org",
  "private": false,
  "version": "2025.1.4",
  "license": "MIT",
  "main": "./dist/view-shadcn.umd.ts",
  "module": "./dist/view-shadcn.es.ts",
  "types": "types/view-shadcn.d.ts",
  "exports": {
    ".": {
      "import": "./dist/view-shadcn-ui.es.ts",
      "require": "./dist/view-shadcn-ui.umd.ts",
      "style": "./dist/view-shadcn-ui.css"
    }
  },
  "files": [
    "dist/*",
    "docs/public/logo.svg"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && tailwindcss build src/assets/index.css -o dist/view-shadcn-ui.min.css --minify",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "dayjs": "^1.11.13",
    "lodash": "^4.17.21",
    "lucide-vue-next": "^0.360.0",
    "monaco-editor": "^0.52.2",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^2.2.2",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "axios": "^1.7.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.37.0",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitepress": "^1.4.1",
    "vue-tsc": "^2.0.6"
  }
}
